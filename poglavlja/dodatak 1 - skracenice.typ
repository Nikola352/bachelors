// Овде пишете скраћенице које сте користили у тексту

#import "../funkcije.typ": dodatak

// Због аутоматског бројања сваки додатак мора имати лабелу са префиксом
// dodatak- као у наслову испод.
= Списак коришћених скраћеница <dodatak-1>

#dodatak(
    table(
        table.header[*Скраћеница*][*Опис*],

        [_API_], [_Application Programming Interface_ -- апликативни програмски интерфејс, скуп функција које једна компонента излаже другој.],

        [_CRDT_], [_Conflict-free Replicated Data Type_ -- бесконфликтни реплицирани тип података, структура података чија својства гарантују конвергенцију реплика.],

        [_DMP_], [_diff-match-patch_ -- библиотека алгоритама за поређење, усклађивање и спајање текста.],

        [_HMAC_], [_Hash-based Message Authentication Code_ -- код за аутентификацију поруке заснован на хеш функцији, коришћен за потписивање порука _Jupyter_ протокола.],

        [_HTTP_], [_HyperText Transfer Protocol_ -- протокол преко чијег се захтјева за надоградњу успоставља _WebSocket_ веза.],

        [_JSON_], [_JavaScript Object Notation_ -- текстуални формат за размјену структурираних података.],

        [_LWW_], [_Last-Write-Wins_ -- „посљедњи запис побјеђује”, стратегија рјешавања конфликата код које преовлађује посљедња примљена измјена.],

        [ОТ], [_Operational Transformation_ -- операциона трансформација, оптимистички механизам контроле конкурентности заснован на трансформацији операција.],

        [_PoC_], [_Proof of Concept_ -- доказ концепта, реализација чија је сврха демонстрација изводљивости, а не продукцијска употреба.],

        [_TCP_], [_Transmission Control Protocol_ -- транспортни протокол који гарантује поуздан пренос и очување редослиједа.],

        [_TP1_, _TP2_], [_Transformation Property 1_ и _2_ -- својства која функција трансформације мора задовољити да би систем заснован на ОТ-у конвергирао.],

        [_UUID_], [_Universally Unique Identifier_ -- глобално јединствен идентификатор.],
    ),
)
